# Intranet gate (optional — if unset, intranet is open in dev)
INTRANET_PASSWORD=change-me

# Public URLs
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-org
NEXT_PUBLIC_GOOGLE_DRIVE_URL=https://drive.google.com/drive/folders/your-root
NEXT_PUBLIC_DRIVE_BRAINSTORM_URL=https://drive.google.com/drive/folders/your-brainstorm
NEXT_PUBLIC_NOTION_URL=https://www.notion.so/your-workspace
NEXT_PUBLIC_TRELLO_URL=https://trello.com/b/your-board

# Google Drive API (service account — share lab folder with client_email from JSON)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# GitHub activity + team hub (server)
GITHUB_ORG=
GITHUB_REPO=your-org/your-repo
GITHUB_TOKEN=

# Meeting Hub — AI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Meeting Hub — OAuth (optional; alternative to service account)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Meeting Hub — local JSON store (Vercel: use external DB for production)
MEETING_HUB_DATA_DIR=
